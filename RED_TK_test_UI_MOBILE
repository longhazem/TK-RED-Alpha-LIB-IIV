local GITHUB_RAW = "https://raw.githubusercontent.com/longhazem/TK-RED-Alpha-LIB-IIV/refs/heads/main/"

local uis = game:GetService("UserInputService")
local is_mobile = uis.TouchEnabled and not uis.KeyboardEnabled

local library = loadstring(game:HttpGet(
    is_mobile and ("https://raw.githubusercontent.com/longhazem/TK-RED-Alpha-LIB-IIV/refs/heads/main/LIB_RED_TK_Mobile")
              or  ("https://raw.githubusercontent.com/longhazem/TK-RED-Alpha-LIB-IIV/refs/heads/main/LIB_RED_TK_PC")
))()

local loader = library:show_loader("TokaiHub", 2.5)

local window = library:window({
    name     = "TokaiHub",
    suffix   = "tech",
    gameInfo = "TokaiHub — Mobile",
    size     = UDim2.fromOffset(is_mobile and 360 or 700, is_mobile and 480 or 565),
})

window:seperator({name = "Combat"})
local aimbot, silent = window:tab({name = "Aimbot", tabs = {"Aimbot", "Silent Aim"}})

for _, tab in {aimbot, silent} do
    local col = tab:column({})
    local section = col:section({name = "General", default = true})

    section:toggle({name = "Enable", seperator = true, flag = "combat_enable", callback = function(bool)
        print("Enable:", bool)
    end})
    section:slider({name = "FOV", flag = "combat_fov", min = 1, max = 360, default = 90, suffix = "°", seperator = true, callback = function(v)
        print("FOV:", v)
    end})
    section:dropdown({name = "Hitbox", flag = "combat_hitbox", items = {"Head", "Neck", "Chest"}, default = "Head", seperator = false})
end

window:seperator({name = "Visuals"})
local esp = window:tab({name = "Visuals", tabs = {"ESP"}})
local col = esp:column({})
local section = col:section({name = "Players", default = true})

local box = section:toggle({name = "Box ESP", seperator = true, flag = "vis_box"})
box:colorpicker({color = Color3.fromRGB(255, 255, 255)})

local name_t = section:toggle({name = "Name", seperator = true, flag = "vis_name"})
name_t:colorpicker({})

section:toggle({name = "Health Bar", seperator = true, flag = "vis_hp"})
section:slider({name = "Max Distance", flag = "vis_dist", min = 10, max = 1000, default = 500, suffix = "m", seperator = false})

window:seperator({name = "Misc"})
local misc = window:tab({name = "Misc", tabs = {"General"}})
local mcol = misc:column({})
local msect = mcol:section({name = "Player", default = true})
msect:slider({name = "Walk Speed", flag = "misc_speed", min = 16, max = 100, default = 16, suffix = "u/s", seperator = true})
msect:toggle({name = "No Fall Damage", flag = "misc_nofall", seperator = false})

library:init_config(window)
