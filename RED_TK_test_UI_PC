local GITHUB_RAW = "https://raw.githubusercontent.com/longhazem/TK-RED-Alpha-LIB-IIV/main/"

local library = loadstring(game:HttpGet(GITHUB_RAW .. "Library_PC.lua"))()

local loader = library:show_loader("TokaiHub", 2.5)

local window = library:window({
    name     = "TokaiHub",
    suffix   = "tech",
    gameInfo = "TokaiHub — PC",
})

window:seperator({name = "Combat"})
local aimbot, silent, trigger = window:tab({name = "Aimbot", tabs = {"Aimbot", "Silent Aim", "Trigger Bot"}})

for _, tab in {aimbot, silent, trigger} do
    local col = tab:column({})
    local section = col:section({name = "General", default = true})

    section:toggle({name = "Enable", seperator = true, flag = "combat_enable", callback = function(bool)
        print("Enable:", bool)
    end})
    section:toggle({name = "Through Walls", seperator = true, flag = "combat_walls"})
    section:slider({name = "FOV", flag = "combat_fov", min = 1, max = 360, default = 90, suffix = "°", seperator = true, callback = function(v)
        print("FOV:", v)
    end})
    section:dropdown({name = "Hitbox", flag = "combat_hitbox", items = {"Head", "Neck", "Chest", "Stomach"}, default = "Head", seperator = true})

    local col2 = tab:column({})
    local section2 = col2:section({name = "Prediction", default = true})
    section2:slider({name = "Ping Compensation", flag = "combat_ping", min = 0, max = 200, default = 50, suffix = "ms", seperator = true})
    section2:toggle({name = "Velocity Prediction", flag = "combat_vel", seperator = false})
end

window:seperator({name = "Visuals"})
local esp, chams, world = window:tab({name = "Visuals", tabs = {"ESP", "Chams", "World"}})

for _, tab in {esp, chams, world} do
    local col = tab:column({})
    local section = col:section({name = "Players", default = true})

    local box = section:toggle({name = "Box ESP", seperator = true, flag = "vis_box"})
    box:colorpicker({color = Color3.fromRGB(255, 255, 255)})

    local name = section:toggle({name = "Name", seperator = true, flag = "vis_name"})
    name:colorpicker({})

    section:toggle({name = "Health Bar", seperator = true, flag = "vis_hp"})
    section:slider({name = "Max Distance", flag = "vis_dist", min = 10, max = 1000, default = 500, suffix = "m", seperator = false})

    local col2 = tab:column({})
    local section2 = col2:section({name = "World", default = true})
    section2:toggle({name = "Dropped Items", seperator = true, flag = "vis_items"})
    section2:toggle({name = "Vehicles", seperator = true, flag = "vis_vehicles"})
end

window:seperator({name = "Misc"})
local misc = window:tab({name = "Misc", tabs = {"General"}})
local col = misc:column({})
local section = col:section({name = "Player", default = true})
section:slider({name = "Walk Speed", flag = "misc_speed", min = 16, max = 100, default = 16, suffix = "u/s", seperator = true})
section:slider({name = "Jump Power", flag = "misc_jump", min = 50, max = 300, default = 50, suffix = "u/s", seperator = true})
section:toggle({name = "No Fall Damage", flag = "misc_nofall", seperator = false})

library:init_config(window)
