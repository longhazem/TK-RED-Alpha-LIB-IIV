local info_tab = window:tab({ name = "Thông Tin" })
local info_col = info_tab:column({})
local sec_info = info_col:section({ name = "Hệ Thống", default = true })

local device  = library.IsMobile and "📱 Mobile" or "🖥️ PC"
local plr     = game.Players.LocalPlayer

sec_info:label({ name = "Thiết bị: " .. device })
sec_info:label({ name = "Tên: " .. plr.Name })
sec_info:label({ name = "ID: " .. plr.UserId })
sec_info:label({ name = "Ping: Đang đo..." })
sec_info:label({ name = "FPS: Đang đo..." })

-- Live FPS + Ping counter (cập nhật mỗi giây)
local fps_label, ping_label
local lc = info_col:section({ name = "Live Stats", default = true })
fps_label  = lc:label({ name = "FPS: --" })
ping_label = lc:label({ name = "Ping: --" })

local _fps_count = 0
local _conn_fps = game:GetService("RunService").RenderStepped:Connect(function() _fps_count += 1 end)
local _conn_hb  = game:GetService("RunService").Heartbeat:Connect(function() end)

task.spawn(function()
    while task.wait(1) do
        if fps_label and fps_label.items and fps_label.items["label"] then
            fps_label.items["label"].Text = "FPS: " .. _fps_count
        end
        _fps_count = 0
        local ping = plr:GetAttribute("Ping") or math.floor(game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue())
        if ping_label and ping_label.items and ping_label.items["label"] then
            ping_label.items["label"].Text = "Ping: " .. tostring(ping) .. "ms"
        end
    end
end)

-- ── Load done notification ────────────────────────────────────────────
task.delay(2.8, function()
    notify("TOKAIHUB", "Load xong! Thiết bị: " .. device, 5)
    indicator:set_text("TOKAIHUB | " .. plr.Name)
end)

