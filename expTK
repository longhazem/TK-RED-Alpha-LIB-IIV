-- Tab 2: Điều Chỉnh
-- ════════════════════════════════════════════════════════════════════ --
local adj_tab = window:tab({ name = "Điều Chỉnh" })
local adj_col = adj_tab:column({})
local adj_col2 = adj_tab:column({})

local sec_accent = adj_col:section({ name = "Màu Accent", default = true })
sec_accent:label({ name = "Đổi màu accent toàn bộ UI", info = "Dùng set_accent_color từ WinWare" })

local preset_colors = {
    ["Xanh dương"] = Color3.fromRGB(100, 160, 255),
    ["Tím"]        = Color3.fromRGB(160, 100, 255),
    ["Đỏ"]         = Color3.fromRGB(255, 80,  80 ),
    ["Xanh lá"]    = Color3.fromRGB(80,  220, 120),
    ["Vàng"]       = Color3.fromRGB(255, 200, 60 ),
    ["Hồng"]       = Color3.fromRGB(255, 120, 180),
}
local color_keys = {}
for k in next, preset_colors do table.insert(color_keys, k) end
table.sort(color_keys)

sec_accent:dropdown({
    name = "Màu preset",
    items = color_keys,
    default = "Xanh dương",
    seperator = true,
    callback = function(v)
        local c = preset_colors[v]
        if c then
            library:set_accent_color(c)
            indicator:set_color(c)
            notify("Accent", "Đã đổi sang " .. v)
        end
    end
})

sec_accent:colorpicker({
    name = "Màu tùy chỉnh",
    default = Color3.fromRGB(100, 160, 255),
    seperator = true,
    callback = function(c)
        library:set_accent_color(c)
        indicator:set_color(c)
        notify("Accent", "Accent đã cập nhật!")
    end
})

local sec_scale = adj_col:section({ name = "AutoScale", default = true })
sec_scale:toggle({
    name = "Bật AutoScale",
    default = true,
    seperator = true,
    callback = function(v) library:SetAutoScaleEnabled(v) end
})
sec_scale:slider({
    name = "Scale multiplier",
    min = 0.5, max = 2.0, default = 1.0, round = 0.05,
    seperator = true,
    callback = function(v) library:SetAutoScaleMultiplier(v) end
})

local sec_indicator = adj_col2:section({ name = "Watermark / Indicator", default = true })
sec_indicator:toggle({
    name = "Hiện watermark",
    default = true,
    seperator = true,
    callback = function(v) indicator:set_visible(v) end
})
sec_indicator:textbox({
    name = "Tên watermark",
    default = "TOKAIHUB | Test",
    placeholder = "Nhập tên...",
    seperator = true,
    callback = function(v)
        if v ~= "" then indicator:set_text(v) end
    end
})

