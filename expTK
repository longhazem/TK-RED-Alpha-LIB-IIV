    seperator = true,
    callback = function(v) notify("Input", "Nhập: " .. v) end
})

-- ── Cột Phải ─────────────────────────────────────────────────────────
local sec_adv = col_r:section({ name = "Nâng Cao", default = true })

sec_adv:label({ name = "Toggle có sub-settings", info = "Bấm mũi tên để mở settings" })
local tog_sub = sec_adv:toggle({
    name = "Aimbot",
    default = false,
    seperator = true,
    callback = function(v) notify("Aimbot", v and "Bật" or "Tắt") end
})
