local window = library:window({
    name = "TokaiHub",
    suffix = "",
    gameInfo = "TokaiHub — All Devices"
})

if library.IsMobile then
    library:add_draggable_button("☰ Menu", function()
        window.toggle_menu()
    end)
end

window:seperator({name = "Combat"})

local enemies, teammates, self_tab = window:tab({
    name = "Visuals",
    icon = "rbxassetid://6034767608",
    tabs = {"Enemies", "Teammates", "Self"}
})

for _, tab in {enemies, teammates, self_tab} do
    local page = tab:sub_tab({order = -10000, size = 2})
    for i = 1, 2 do
        local col = page:column({})
        local sec = col:section({name = "ESP", default = true})
        sec:toggle({name = "Enable ESP", seperator = true, flag = "esp_enabled", callback = function(v) print("ESP:", v) end})
        sec:toggle({name = "Through Walls", seperator = true, flag = "esp_walls"})
        sec:toggle({name = "Shared ESP", seperator = true, flag = "esp_shared"}):colorpicker({flag = "esp_color"})
        local nameTog = sec:toggle({name = "Name Tag", seperator = true, flag = "esp_nametag"})
        nameTog:colorpicker({flag = "esp_nametag_color"})
        local sub = nameTog:settings({})
        sub:toggle({name = "Show Display Name", seperator = true, flag = "esp_displayname"})
        sub:dropdown({name = "Font", items = {"ProggyTiny", "MonoSpace", "Tahoma"}, default = "MonoSpace", seperator = true, flag = "esp_font"})
        sub:colorpicker({name = "Outline Color", seperator = true, flag = "esp_outline_col"})
        sub:keybind({name = "Toggle Key", flag = "esp_toggle_key", callback = function(v) print("ESP toggled:", v) end})
        sec:toggle({name = "Weapon", seperator = true, flag = "esp_weapon"}):colorpicker({flag = "esp_weapon_color"})
        sec:dropdown({name = "Flags", items = {"Scoped","Flashed","Knocked","Touched"}, default = {"Scoped","Flashed"}, multi = true, seperator = true, flag = "esp_flags"})
        sec:toggle({name = "Skeleton", seperator = false, flag = "esp_skeleton"})
    end
end

window:seperator({name = "Aimbot"})

local aim_main, aim_cfg = window:tab({
    name = "Aimbot",
    icon = "rbxassetid://6031094667",
    tabs = {"Main", "Config"}
})

do
    local col = aim_main:column({})
    local sec = col:section({name = "Aimbot", default = true})
    sec:toggle({name = "Enable", seperator = true, flag = "aim_on", callback = function(v) print("Aim:", v) end})
    sec:slider({name = "FOV", min = 1, max = 360, default = 90, suffix = "°", flag = "aim_fov"})
    sec:slider({name = "Smoothness", min = 0, max = 100, default = 50, suffix = "%", flag = "aim_smooth"})
    sec:dropdown({name = "Hitbox", items = {"Head", "Torso", "Nearest"}, default = "Head", flag = "aim_part"})
    sec:keybind({name = "Aim Key", flag = "aim_key", key = Enum.KeyCode.Q, callback = function(v) print("Holding:", v) end})
    local col2 = aim_main:column({})
    local sec2 = col2:section({name = "Prediction", default = true})
    sec2:toggle({name = "Bullet Prediction", seperator = true, flag = "aim_pred"})
    sec2:slider({name = "Velocity Scale", min = 0, max = 200, default = 100, suffix = "%", flag = "aim_vel"})
end

window:seperator({name = "Misc"})

local misc = window:tab({name = "Misc", icon = "rbxassetid://6034509993", tabs = {"Main"}})

do
    local col = misc:column({})
    local sec = col:section({name = "Movement", default = true})
    sec:toggle({name = "Infinite Jump", seperator = true, flag = "inf_jump", callback = function(v)
        if v then
            game:GetService("UserInputService").JumpRequest:Connect(function()
                game:GetService("Players").LocalPlayer.Character:FindFirstChildOfClass("Humanoid"):ChangeState(Enum.HumanoidStateType.Jumping)
            end)
        end
    end})
    sec:slider({name = "Walk Speed", min = 16, max = 200, default = 16, flag = "wspd", callback = function(v)
        local hum = game:GetService("Players").LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum then hum.WalkSpeed = v end
    end})
    sec:toggle({name = "No Clip", seperator = false, flag = "noclip"})
    local col2 = misc:column({})
    local sec2 = col2:section({name = "HUD", default = true})
    sec2:toggle({name = "Info Panel", seperator = true, flag = "hud_info", callback = function(v)
        library:info_list({enabled = v, watermark = "TokaiHub", items = {fps=true, ping=true, username=true, session=true}})
    end})
    sec2:toggle({name = "Keybind List", seperator = false, flag = "hud_kb", callback = function(v)
        library:keybind_list({enabled = v})
    end})
end

