local col_r  = ui_tab:column({})

-- ── Cột Trái ─────────────────────────────────────────────────────────
local sec_basic = col_l:section({ name = "Cơ Bản", default = true })

sec_basic:label({ name = "Toggle + Colorpicker kết hợp", info = "Bấm nút màu để mở colorpicker" })
local tog_color = sec_basic:toggle({
