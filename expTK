sec_basic:toggle({
    name = "Infinite Jump",
    default = false,
    seperator = true,
    callback = function(v)
        getgenv().TK_InfJump = v
        if v then
            if not getgenv().TK_InfJumpConn then
                getgenv().TK_InfJumpConn = game:GetService("UserInputService").JumpRequest:Connect(function()
                    if getgenv().TK_InfJump then
                        local char = game.Players.LocalPlayer.Character
                        local hum = char and char:FindFirstChildOfClass("Humanoid")
                        if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
                    end
                end)
            end
        end
        notify("Jump", v and "Bật Infinite Jump" or "Tắt Infinite Jump")
    end
})

sec_basic:toggle({
    name = "Noclip",
    default = false,
    seperator = true,
    callback = function(v)
        getgenv().TK_Noclip = v
        if v then
            if not getgenv().TK_NoclipConn then
                getgenv().TK_NoclipConn = game:GetService("RunService").Stepped:Connect(function()
                    if getgenv().TK_Noclip then
                        local char = game.Players.LocalPlayer.Character
                        if char then
                            for _, p in char:GetDescendants() do
                                if p:IsA("BasePart") then
                                    p.CanCollide = false
                                end
                            end
                        end
                    end
                end)
            end
        end
        notify("Noclip", v and "Bật Noclip" or "Tắt Noclip")
    end
})

