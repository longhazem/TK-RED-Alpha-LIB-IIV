                end
                pcall(library.info_list, library, opts)
            end

            function TokaiHub:build_info_settings(parent, options)
                options = options or {}
                if type(parent) ~= "table" then
                    return
                end
                if options.watermark ~= nil then
                    TokaiHub._info_watermark = tostring(options.watermark)
                end

                local yield = type(options.yield) == "function" and options.yield or function() end

                local opts = TokaiHub._info_opts
                if type(opts) ~= "table" then
                    opts = TokaiHub:_info_default_opts()
                    TokaiHub._info_opts = opts
                end
                opts.items = opts.items or {}
                if TokaiHub._info_watermark ~= nil then
                    opts.watermark = TokaiHub._info_watermark
                end

                local function apply()
                    TokaiHub:_apply_info_from_flags()
