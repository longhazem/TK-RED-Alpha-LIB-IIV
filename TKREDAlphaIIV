-- SetAccentColor / accent repaint (WinWare)
TokaiHub.AccentRepaintFrom   = nil
TokaiHub.AccentRepaintQueued = false

TokaiHub.RepaintAccent = function(previous, color)
    local objects = (TokaiHub.items and TokaiHub.items.Parent) and TokaiHub.items:GetDescendants() or {}
    local locked  = {}
    for _, obj in objects do
        if pcall(function() return obj:GetAttribute('TokaiHubNoAccent') end) and obj:GetAttribute('TokaiHubNoAccent') then locked[obj]=true end
    end
    local function same(v)
        return v and previous and math.abs(v.R-previous.R)<0.004 and math.abs(v.G-previous.G)<0.004 and math.abs(v.B-previous.B)<0.004
    end
    local function isLocked(obj) local c=obj; while c do if locked[c] then return true end; c=c.Parent end end
    for _, obj in objects do
        if not isLocked(obj) then
            if obj:IsA('UIStroke') and same(obj.Color) then obj.Color=color
            elseif obj:IsA('GuiObject') then
                if same(obj.BackgroundColor3) then obj.BackgroundColor3=color end
                if (obj:IsA('TextLabel') or obj:IsA('TextButton') or obj:IsA('TextBox')) and same(obj.TextColor3) then obj.TextColor3=color end
                if (obj:IsA('ImageLabel') or obj:IsA('ImageButton')) and same(obj.ImageColor3) then obj.ImageColor3=color end
            end
        end
    end
end

function TokaiHub:SetAccentColor(color)
    if type(color)=='string' then color=Color3.fromHex(color:gsub('#','')) end
    if TokaiHub.AccentColor==color then return end
    if not TokaiHub.AccentRepaintFrom then TokaiHub.AccentRepaintFrom=TokaiHub.AccentColor end
    TokaiHub.AccentColor=color
    TokaiHub:update_theme('accent', color)
    if TokaiHub.AccentRepaintQueued then return end
    TokaiHub.AccentRepaintQueued=true
    task.defer(function()
        local prev=TokaiHub.AccentRepaintFrom; TokaiHub.AccentRepaintFrom=nil; TokaiHub.AccentRepaintQueued=false
        if prev and prev~=TokaiHub.AccentColor then TokaiHub.RepaintAccent(prev,TokaiHub.AccentColor) end
    end)
end

-- Base64 + Encryption (WinWare)
do
    local b='ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/'
    TokaiHub.Base64Encode = function(data)
        return ((data:gsub('.',function(x)
            local r,byte='',x:byte()
            for i=8,1,-1 do r=r..(byte%2^i-byte%2^(i-1)>0 and '1' or '0') end; return r
        end)..'0000'):gsub('%d%d%d?%d?%d?%d?',function(x)
            if #x<6 then return '' end
            local c=0; for i=1,6 do c=c+(x:sub(i,i)=='1' and 2^(6-i) or 0) end; return b:sub(c+1,c+1)
        end)..({'','==','='})[#data%3+1])
    end
    TokaiHub.Base64Decode = function(data)
        data=data:gsub('[^'..b..'=]','')
        return (data:gsub('.',function(x)
            if x=='=' then return '' end
            local r,f='',b:find(x)-1
            for i=6,1,-1 do r=r..(f%2^i-f%2^(i-1)>0 and '1' or '0') end; return r
        end):gsub('%d%d%d?%d?%d?%d?%d?%d?',function(x)
            if #x~=8 then return '' end
            local c=0; for i=1,8 do c=c+(x:sub(i,i)=='1' and 2^(8-i) or 0) end; return string.char(c)
        end))
    end
end
TokaiHub.Encryption = {}
function TokaiHub.Encryption.new(data)
    local bytes,seed={},((#data+3782)%111)+1
    data:gsub('.',function(c) insert(bytes,tostring(c:byte()+seed)) end)
    local r='{'..tostring(seed+72667)..'}?'..table.concat(bytes,'?'); table.clear(bytes); return r
end
function TokaiHub.Encryption.reverse(data)
    local parts=data:split('?'); local seed=tonumber(parts[1]:gsub('[{}]',''))-72667
    local chars={}; for i=2,#parts do insert(chars,string.char(tonumber(parts[i])-seed)) end
    local out=table.concat(chars); table.clear(chars); return out
end

