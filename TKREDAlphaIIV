        -- Draggable floating button (Mobile toggle + any floating button)
        function library:add_draggable_button(text, func)
            local tbl = {}
            -- Always use dedicated btn_gui — never library["items"] which hides with the menu
            local scrGui = library._btn_gui or coregui
            local holder = library:create("Frame", {
                BackgroundColor3 = rgb(22, 22, 24),
                BorderColor3 = rgb(60, 60, 65),
                Position = dim_offset(6, 6),
                Size = dim_offset(82, 32),
                ZIndex = 300,
                Parent = scrGui,
            })
            local inner = library:create("Frame", {
                BackgroundColor3 = rgb(38, 38, 38),
                BorderColor3 = rgb(50, 50, 50),
                Size = dim2(1, 0, 1, 0),
                ZIndex = 301,
                Parent = holder,
            })
            local label = library:create("TextLabel", {
                Size = dim2(1, 0, 1, 0),
                BackgroundTransparency = 1,
                Text = text,
                TextColor3 = rgb(255, 255, 255),
                TextSize = 13,
                Font = Enum.Font.Code,
                ZIndex = 302,
                Parent = inner,
            })

            -- Drag logic (mouse + touch)
            do
                local _dragging = false
                local _draggingInput = nil
                local _dragStart = nil
                local _startPos = nil

                holder.InputBegan:Connect(function(input)
                    local isClick = input.UserInputType == Enum.UserInputType.MouseButton1
                    local isTouch = input.UserInputType == Enum.UserInputType.Touch
                    if not (isClick or isTouch) then return end
                    _dragging = true
                    _draggingInput = input
                    _dragStart = input.Position
                    _startPos = holder.Position
                    local conn
                    conn = input.Changed:Connect(function()
                        if input.UserInputState == Enum.UserInputState.End then
                            _dragging = false
                            if conn and conn.Connected then conn:Disconnect() end
                        end
                    end)
                end)

                library:connection(uis.InputChanged, function(input)
                    if not _dragging or not _draggingInput then return end
                    local isMoveMatch = (input.UserInputType == Enum.UserInputType.MouseMovement
                        and _draggingInput.UserInputType == Enum.UserInputType.MouseButton1)
                    local isTouchMatch = (input == _draggingInput
                        and input.UserInputType == Enum.UserInputType.Touch)
                    if not (isMoveMatch or isTouchMatch) then return end
                    local delta = input.Position - _dragStart
                    holder.Position = dim2(
                        _startPos.X.Scale, _startPos.X.Offset + delta.X,
                        _startPos.Y.Scale, _startPos.Y.Offset + delta.Y
                    )
                end)
            end

            -- Tap-to-click (only fires if position didn't change = tap not drag)
            holder.InputBegan:Connect(function(input)
                if input.UserInputType ~= Enum.UserInputType.MouseButton1
                    and input.UserInputType ~= Enum.UserInputType.Touch then return end
                local origPos = holder.Position
                task.wait(0.15)
                if holder.Position == origPos and type(func) == "function" then
                    func(tbl)
                end
            end)

            tbl.holder = holder
            tbl.label  = label
            function tbl:set_text(t) label.Text = t end
            function tbl:set_position(x, y) holder.Position = dim_offset(x, y) end
            return tbl
        end

        function library:convert(str)
            local values = {}

            for value in string.gmatch(str, "[^,]+") do
                insert(values, tonumber(value))
            end
            
            if #values == 4 then              
                return unpack(values)
            else 
                return
            end
        end
        
        function library:convert_enum(enum)
            local enum_parts = {}
        
            for part in string.gmatch(enum, "[%w_]+") do
                insert(enum_parts, part)
            end
        
            local enum_table = Enum
            for i = 2, #enum_parts do
                local enum_item = enum_table[enum_parts[i]]
        
                enum_table = enum_item
            end
        
            return enum_table
        end

