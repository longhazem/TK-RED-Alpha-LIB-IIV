-- ── SplashAnimation (ported from libba, adapted for TOKAIHUB) ────────
function library:splash_animation()
    local tween_service = game:GetService("TweenService")

    local splash_bg = Instance.new("Frame")
    splash_bg.BackgroundColor3 = rgb(10, 10, 12)
    splash_bg.BackgroundTransparency = 0
    splash_bg.BorderSizePixel = 0
    splash_bg.Size = dim2(1, 0, 1, 0)
    splash_bg.ZIndex = 200
    splash_bg.Parent = _OverlayGui

    local splash_label = Instance.new("TextLabel")
    splash_label.AnchorPoint = vec2(0.5, 0.5)
    splash_label.BackgroundTransparency = 1
    splash_label.Position = dim2(0.5, 0, 0.44, 0)
    splash_label.Size = dim_offset(260, 56)
    splash_label.Text = "TOKAIHUB"
    splash_label.TextColor3 = rgb(255, 255, 255)
    splash_label.TextSize = _IsMobile and 34 or 42
    splash_label.Font = Enum.Font.Code
    splash_label.TextTransparency = 1
    splash_label.ZIndex = 201
    splash_label.Parent = splash_bg

    local sub_label = Instance.new("TextLabel")
    sub_label.AnchorPoint = vec2(0.5, 0.5)
    sub_label.BackgroundTransparency = 1
    sub_label.Position = dim2(0.5, 0, 0.52, 0)
    sub_label.Size = dim_offset(200, 20)
    sub_label.Text = "by @longtokai"
    sub_label.TextColor3 = rgb(130, 130, 130)
    sub_label.TextSize = 13
    sub_label.Font = Enum.Font.Code
    sub_label.TextTransparency = 1
    sub_label.ZIndex = 201
    sub_label.Parent = splash_bg

    local progress_back = Instance.new("Frame")
    progress_back.AnchorPoint = vec2(0.5, 0.5)
    progress_back.BackgroundColor3 = rgb(28, 28, 30)
    progress_back.BackgroundTransparency = 1
    progress_back.BorderSizePixel = 0
    progress_back.Position = dim2(0.5, 0, 0.59, 0)
    progress_back.Size = dim_offset(_IsMobile and 180 or 220, 3)
    progress_back.ZIndex = 201
    progress_back.Parent = splash_bg

    local progress_fill = Instance.new("Frame")
    progress_fill.BackgroundColor3 = themes.preset.accent
    progress_fill.BackgroundTransparency = 1
    progress_fill.BorderSizePixel = 0
    progress_fill.Size = dim2(0, 1, 1, 0)
    progress_fill.ZIndex = 202
    progress_fill.Parent = progress_back

    local fade_time = 0.45

    tween_service:Create(splash_bg,     TweenInfo.new(fade_time), {BackgroundTransparency = 0}):Play()
    tween_service:Create(splash_label,  TweenInfo.new(fade_time), {TextTransparency = 0}):Play()
    tween_service:Create(sub_label,     TweenInfo.new(fade_time), {TextTransparency = 0}):Play()
    tween_service:Create(progress_back, TweenInfo.new(fade_time), {BackgroundTransparency = 0}):Play()
    tween_service:Create(progress_fill, TweenInfo.new(fade_time), {BackgroundTransparency = 0}):Play()

    task.wait(fade_time + 0.15)

    tween_service:Create(progress_fill, TweenInfo.new(1.4, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Size = dim2(1, 0, 1, 0)}):Play()

    task.wait(1.6)

    tween_service:Create(splash_bg,     TweenInfo.new(fade_time), {BackgroundTransparency = 1}):Play()
    tween_service:Create(splash_label,  TweenInfo.new(fade_time), {TextTransparency = 1}):Play()
    tween_service:Create(sub_label,     TweenInfo.new(fade_time), {TextTransparency = 1}):Play()
    tween_service:Create(progress_back, TweenInfo.new(fade_time), {BackgroundTransparency = 1}):Play()
    tween_service:Create(progress_fill, TweenInfo.new(fade_time), {BackgroundTransparency = 1}):Play()

    task.wait(fade_time)
    splash_bg:Destroy()
end

-- Auto-run splash on load (non-blocking)
task.spawn(function() library:splash_animation() end)

return library
