            function TokaiHub:_apply_info_from_flags()
                if type(library.info_list) ~= "function" then
                    return
                end
                local opts = TokaiHub._info_opts
                if type(opts) ~= "table" then
                    opts = TokaiHub:_info_default_opts()
                    TokaiHub._info_opts = opts
                end
                opts.items = opts.items or {}
                if TokaiHub._info_watermark ~= nil then
