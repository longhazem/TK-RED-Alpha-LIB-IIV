            Size = dim2(0, 272, 0, 0);
            BackgroundColor3 = rgb(18, 18, 21);
            BorderSizePixel = 0;
            Visible = false;
            ZIndex = 6;
            ClipsDescendants = true;
            ScrollBarThickness = 3;
            ScrollBarImageColor3 = rgb(44, 44, 46);
