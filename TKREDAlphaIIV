-- Gamepad toggle support injection (called after window is created)
TokaiHub._setup_gamepad_toggle = function(toggle_fn)
    if not TokaiHub.IsConsole then return end
    TokaiHub:connection(uis.InputBegan, function(inp)
        if inp.UserInputType==Enum.UserInputType.Gamepad1 and inp.KeyCode==Enum.KeyCode.ButtonSelect then
            pcall(toggle_fn)
        end
    end)
end

