-- Asset loading (WinWare)
do
    local assetDir  = 'TokaiHubAssets'
    local assetLink = 'https://raw.githubusercontent.com/wxnvxa/winware-lib/main/assets/%s'
    if type(makefolder)=='function' then pcall(makefolder, assetDir) end
    local function LoadAsset(name)
        if type(isfile)~='function' or type(getcustomasset)~='function' then return nil end
        local path = assetDir..'/'..name
        if not isfile(path) then
            local data = http_get(string.format(assetLink, name))
            if data and type(writefile)=='function' then writefile(path, data); task.wait() end
        end
        if isfile(path) then local ok,r=pcall(getcustomasset,path); return ok and r or nil end
    end
    local okL,logo = pcall(LoadAsset,'winware.png')
    local okM,mapp = pcall(LoadAsset,'saturation_value_gradient.png')
    if okL and logo then TokaiHub.GlobalLogo       = logo end
    if okM and mapp then TokaiHub.ImageColorMapping = mapp end
end

