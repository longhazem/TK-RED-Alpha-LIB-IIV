        function TokaiHub:get_config()
            local Config = {}

            pcall(function()
                if TokaiHub._capture_hud_positions then
                    TokaiHub:_capture_hud_positions()
                end
            end)

            for _, v in next, flags do
                if _ == "config_autoload_enabled" or _ == "config_autoload_name" then
                    -- auto-load target lives only in autoload.txt; never bake it into a saved config
                elseif type(v) == "table" and v.key then
                    Config[_] = {active = v.active, mode = v.mode, key = tostring(v.key)}
                elseif type(v) == "table" and v["Transparency"] and v["Color"] then
                    Config[_] = {Transparency = v["Transparency"], Color = v["Color"]:ToHex()}
                else
                    Config[_] = v
                end
            end
            
            return http_service:JSONEncode(Config)
        end

        function TokaiHub:load_config(config_json) 
            TokaiHub._loading_config = true
            local config = http_service:JSONDecode(config_json)
            
            for _, v in config do 
                local function_set = TokaiHub.config_flags[_]
                
                if _ == "config_name_list" then 
                    continue 
                end

                if function_set then 
                    if type(v) == "table" and v["Transparency"] and v["Color"] then
                        function_set(hex(v["Color"]), v["Transparency"])
                    elseif type(v) == "table" and v["active"] ~= nil then 
                        function_set(v)
                    else
                        function_set(v)
                    end
                end
            end

            pcall(function()
                if TokaiHub._apply_hud_positions then
                    TokaiHub:_apply_hud_positions(config)
                end
            end)

            pcall(function()
                if TokaiHub._apply_window_background then
                    TokaiHub:_apply_window_background()
                end
            end)

            TokaiHub._loading_config = false
        end
        
        function TokaiHub:round(number, float) 
            local multiplier = 1 / (float or 1)

            return floor(number * multiplier + 0.5) / multiplier
        end 

        function TokaiHub:apply_theme(instance, theme, property) 
            insert(themes.utility[theme][property], instance)
        end

        function TokaiHub:update_theme(theme, color)
            local utility = themes.utility[theme]
            local previous = themes.preset[theme]
            local history = themes.history and themes.history[theme]

            if history then
                local function remember(theme_color)
                    if not theme_color then
                        return
                    end

                    for _, known in history do
                        if known == theme_color then
                            return
                        end
                    end

                    insert(history, theme_color)
                end

                remember(previous)
                remember(color)
            end

            if not utility then
                themes.preset[theme] = color
                return
            end

            local function is_theme_color(value)
                if value == previous or value == color then
                    return true
                end

                if history then
                    for _, known in history do
                        if value == known then
                            return true
                        end
                    end
                end

                return false
            end

            for property_name, property in utility do
                local stale

                for index, object in property do
                    local ok, current = pcall(function()
                        return object[property_name]
                    end)

                    if ok and is_theme_color(current) then
                        local set_ok = pcall(function()
                            object[property_name] = color
                        end)

                        if not set_ok then
                            stale = stale or {}
                            insert(stale, index)
                        end
                    elseif not ok then
                        stale = stale or {}
                        insert(stale, index)
                    end 
                end

                if stale then
                    for i = #stale, 1, -1 do
                        remove(property, stale[i])
                    end
                end
            end 

            themes.preset[theme] = color

            if theme == "accent" then
                pcall(function()
                    if TokaiHub._window_title_label then
                        TokaiHub._window_title_label.TextColor3 = color
                    end
                    if TokaiHub._window_footer_label then
                        TokaiHub._window_footer_label.TextColor3 = color
                    end
                end)
            end

            if TokaiHub._refresh_keybind_list then
                TokaiHub:_refresh_keybind_list()
            end

            if TokaiHub._info_list and TokaiHub._refresh_info_list then
                TokaiHub:_refresh_info_list()
            end

            local after_theme_update = TokaiHub._brm5_after_theme_update
            if type(after_theme_update) == "function" then
                pcall(after_theme_update, theme, color)
            end
        end

        function TokaiHub:connection(signal, callback)
            local connection = signal:Connect(callback)
            
            insert(TokaiHub.connections, connection)

            return connection 
        end

        function TokaiHub:close_element(new_path) 
            local open_element = TokaiHub.current_open

            if open_element and new_path ~= open_element then
                open_element.set_visible(false)
                open_element.open = false;
            end 

            if new_path ~= open_element then 
                TokaiHub.current_open = new_path or nil;
            end
        end 

        function TokaiHub:create(instance, options)
            local ins = Instance.new(instance) 
            
            for prop, value in options do 
                ins[prop] = value
            end
            
            return ins 
        end

        function TokaiHub:_keybind_list_option(name, fallback)
            local list = TokaiHub._keybind_list
            local options = list and list.options

            if options and options[name] ~= nil then
                return options[name]
            end

            return fallback
        end

        function TokaiHub:_keybind_list_has_key(key)
            if not key or key == "NONE" then
                return false
            end

            local key_string = tostring(key)
            return key_string ~= "Enum.KeyCode.Unknown"
                and key_string ~= "Enum.UserInputType.None"
                and key_string ~= "Unknown"
        end

        function TokaiHub:_keybind_list_key_text(key)
            if not TokaiHub:_keybind_list_has_key(key) then
                return "NONE"
            end

            local text = keys[key] or tostring(key):gsub("Enum.", "")
            return tostring(text):gsub("KeyCode.", ""):gsub("UserInputType.", "")
        end

        function library:_keybind_list_title_from_flag(flag)
            local text = tostring(flag or "Keybind")
                :gsub("_keybind$", "")
                :gsub("_key$", "")
                :gsub("_", " ")

            return (text:gsub("(%a)([%w']*)", function(first, rest)
                return string.upper(first) .. string.lower(rest)
            end))
        end

        function TokaiHub:_keybind_list_entry_name(entry)
            local names = TokaiHub._keybind_list_names
            local cfg = entry and entry.cfg
            local flag = cfg and cfg.flag
            local mapped = names and flag and names[flag]

            if mapped and mapped ~= "" then
                return mapped
            end

            local name = entry and entry.name
            if name and name ~= "" and name ~= "Toggle Key" and name ~= "Modifier Key" and name ~= "Keybind" then
                return name
            end

            return library:_keybind_list_title_from_flag(flag)
        end

