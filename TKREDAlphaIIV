        function TokaiHub:_refresh_keybind_list()
            local list = TokaiHub:_ensure_keybind_list()
            local items = list.items
            local options = list.options

            if TokaiHub._keybind_list_lock_defaults == true and TokaiHub._keybind_list_user_touched ~= true then
                options.enabled = true
                options.mode = "All"
                options.show_unbound = false
                options.auto_height = true

                local sync_controls = TokaiHub._keybind_list_sync_controls
                if type(sync_controls) == "function" and TokaiHub._keybind_list_syncing_controls ~= true then
                    local previous_syncing = TokaiHub._keybind_list_syncing_controls
                    local previous_forcing = TokaiHub._keybind_list_forcing_defaults
                    TokaiHub._keybind_list_syncing_controls = true
                    TokaiHub._keybind_list_forcing_defaults = true
                    sync_controls()
                    TokaiHub._keybind_list_forcing_defaults = previous_forcing
                    TokaiHub._keybind_list_syncing_controls = previous_syncing
                end
            end

            if not items["outline"] then
                if not TokaiHub["keybind_gui"] and not coregui then
                    return
                end

                TokaiHub:_create_keybind_list()
                items = list.items
            end

            if TokaiHub["keybind_gui"] then
                TokaiHub["keybind_gui"].Enabled = options.enabled == true
            end

            items["outline"].Visible = options.enabled == true
            items["outline"].Size = dim2(0, options.width, 0, items["outline"].Size.Y.Offset)

            local kbd_bg_t = 1 - clamp(tonumber(options.background_opacity) or 1, 0, 1)
            items["outline"].BackgroundTransparency = kbd_bg_t
            if items["inline"] then
                items["inline"].BackgroundTransparency = kbd_bg_t
            end
            if items["shadow"] then
                items["shadow"].ImageTransparency = kbd_bg_t
            end

            for _, row in list.rows do
                row:Destroy()
            end
            list.rows = {}

            local mode = tostring(options.mode or "All")
            local active_only = string.lower(mode) == "active" or string.lower(mode) == "enabled"
            local rows = {}

            for source_index, flag in list.order do
                local entry = list.entries[flag]
                local cfg = entry and entry.cfg

                if cfg and not cfg.ignore_key then
                    entry.order = entry.order or source_index
                    local has_key = TokaiHub:_keybind_list_has_key(cfg.key)

                    if (has_key or options.show_unbound == true) and (not active_only or cfg.active == true) then
                        rows[#rows + 1] = entry
                    end
                end
            end

            table.sort(rows, function(a, b)
                local a_active = a.cfg and a.cfg.active == true
                local b_active = b.cfg and b.cfg.active == true

                if a_active ~= b_active then
                    return a_active
                end

                return (a.order or 0) < (b.order or 0)
            end)

            items["mode"].Text = active_only and "ACTIVE" or "ALL"
            items["mode"].TextColor3 = themes.preset.accent

            if #rows == 0 then
