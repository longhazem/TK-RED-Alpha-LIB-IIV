            function cfg.toggle_menu(bool)
                if bool == nil then
                    bool = not library[ "items" ].Enabled
                end

                local main = items[ "main" ]
                if bool then
                    library[ "items" ].Enabled = true
                    if main then
                        local _vp2 = (ws.CurrentCamera and ws.CurrentCamera.ViewportSize) or Vector2.new(1920,1080)
                        local _cx2 = math.floor((_vp2.X - cfg.size.X.Offset) / 2)
                        local _cy2 = math.floor((_vp2.Y - cfg.size.Y.Offset) / 2)
                        main.Size = UDim2.fromOffset(
                            math.floor(cfg.size.X.Offset * 0.94),
                            math.floor(cfg.size.Y.Offset * 0.94)
                        )
                        main.Position = UDim2.fromOffset(
                            math.floor((_vp2.X - cfg.size.X.Offset * 0.94) / 2),
                            math.floor((_vp2.Y - cfg.size.Y.Offset * 0.94) / 2)
                        )
                        main.BackgroundTransparency = 1
                        library:tween(main, { BackgroundTransparency = 0 }, Enum.EasingStyle.Quint, 0.32)
                        library:tween(main, { Size = cfg.size, Position = UDim2.fromOffset(_cx2, _cy2) }, Enum.EasingStyle.Back, 0.44)
                    end
                else
                    if main then
                        library:tween(main, {
                            BackgroundTransparency = 1,
                            Size = UDim2.fromOffset(
                                math.floor(cfg.size.X.Offset * 0.94),
                                math.floor(cfg.size.Y.Offset * 0.94)
                            )
                        }, Enum.EasingStyle.Quint, 0.22)
                        task.delay(0.22, function()
                            library[ "items" ].Enabled = false
                        end)
                    else
                        library[ "items" ].Enabled = false
                    end
                end
            end

            -- ── Toggle button (Mobile = draggable float, PC = fixed top-left) ──
            do
                -- Init btn_gui here if window() is called before add_draggable_button
                if not library._btn_gui then
                    library._btn_gui = Instance.new("ScreenGui")
                    library._btn_gui.Name = "tokaihub_btns"
                    library._btn_gui.Enabled = true
                    library._btn_gui.ZIndexBehavior = Enum.ZIndexBehavior.Global
                    library._btn_gui.IgnoreGuiInset = true
                    library._btn_gui.DisplayOrder = 100
                    pcall(function()
                        if type(gethui) == "function" then
                            library._btn_gui.Parent = gethui()
                        else
                            library._btn_gui.Parent = coregui
                        end
                    end)
                end

                local _toggleBtn = library:add_draggable_button(
                    library._menuOpen and "✕ TOKAI" or "☰ TOKAI",
                    function() cfg.toggle_menu() end
                )
                _toggleBtn:set_position(6, 6)

                -- On PC also add a Lock button below it (like obsidian)
                local _lockBtn
                if not library.IsMobile then
                    _lockBtn = library:add_draggable_button("Lock", function(self)
                        library._drag_locked = not library._drag_locked
                        self:set_text(library._drag_locked and "Unlock" or "Lock")
                    end)
                    _lockBtn:set_position(6, 46)
                end

                -- Wrap toggle_menu to keep button label in sync
                local _origToggle = cfg.toggle_menu
                cfg.toggle_menu = function(bool)
                    _origToggle(bool)
                    local isOpen = library["items"].Enabled
                    library._menuOpen = isOpen
                    _toggleBtn:set_text(isOpen and "✕ TOKAI" or "☰ TOKAI")
                end

                library._toggle_btn = _toggleBtn
                library._lock_btn = _lockBtn
            end
            -- ─────────────────────────────────────────────────────────────────

            return setmetatable(cfg, library)
        end

