TokaiHub.CreateSignal = function(defaultValue)
    local cache=Instance.new('BindableEvent')
    local bind={Value=defaultValue, __event=cache}
    function bind:GetValue() return bind.Value end
    function bind:SetValue(f) bind.Value=f; cache:Fire(f) end
    function bind:Connect(f) return cache.Event:Connect(f) end
    return bind
end

