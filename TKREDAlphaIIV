                if text == query then return true, 1000 end
                if string.find(text, query, 1, true) then
                    local pos = string.find(text, query, 1, true)
                    return true, 500 - pos
                end
                local qi = 1
                local score = 0
                local last_match = 0
                for i = 1, #text do
                    if qi <= #query and string.sub(text, i, i) == string.sub(query, qi, qi) then
                        score = score + 10
                        if i == last_match + 1 then
                            score = score + 5
                        end
                        last_match = i
                        qi = qi + 1
                    end
                end
                if qi > #query then
                    return true, score
                end
                return false, 0
