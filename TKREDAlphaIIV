                Image = "http://www.roblox.com/asset/?id=6031090990",
                BackgroundTransparency = 1,
                Position = dim2(0, 10, 0.5, 0),
                Name = "\0",
                Size = dim2(0, 22, 0, 22),
                BorderSizePixel = 0,
                BackgroundColor3 = rgb(255, 255, 255),
            })
            TokaiHub:apply_theme(rl_items["Icon"], "accent", "ImageColor3")

            TokaiHub:create("TextLabel", {
                FontFace = fonts.font,
                TextColor3 = rgb(255, 255, 255),
                BorderColor3 = rgb(0, 0, 0),
                Text = rl_cfg.name,
                Parent = rl_items["header"],
                Name = "\0",
                Size = dim2(0, 0, 1, 0),
                Position = dim2(0, 40, 0, -1),
                BackgroundTransparency = 1,
                TextXAlignment = Enum.TextXAlignment.Left,
                BorderSizePixel = 0,
                AutomaticSize = Enum.AutomaticSize.X,
                TextSize = 16,
                BackgroundColor3 = rgb(255, 255, 255),
            })

            TokaiHub:create("Frame", {
                AnchorPoint = vec2(0, 1),
                Parent = rl_items["header"],
                Position = dim2(0, 0, 1, 0),
                BorderColor3 = rgb(0, 0, 0),
                Size = dim2(1, 0, 0, 1),
                BorderSizePixel = 0,
                BackgroundColor3 = rgb(36, 36, 37),
            })

            rl_items["list_frame"] = TokaiHub:create("Frame", {
                Parent = rl_items["inline"],
                Name = "\0",
                Position = dim2(0, 0, 0, 35),
                Size = dim2(1, 0, 1, -35),
                BackgroundTransparency = 1,
                BorderSizePixel = 0,
                ClipsDescendants = true,
            })

            local indicator_line = TokaiHub:create("Frame", {
                Parent = rl_items["list_frame"],
                Name = "\0",
                Size = dim2(1, -20, 0, 2),
                Position = dim2(0, 10, 0, 0),
                BackgroundColor3 = themes.preset.accent,
                BorderSizePixel = 0,
                ZIndex = 55,
                Visible = false,
            })
            TokaiHub:create("UICorner", { Parent = indicator_line, CornerRadius = dim(0, 1) })
            TokaiHub:apply_theme(indicator_line, "accent", "BackgroundColor3")

            local function get_row_y(idx)
                return LIST_PAD + (idx - 1) * ROW_H
            end

            local function refresh_positions(skip_key, animate)
                for i, key in ipairs(rl_cfg.order) do
                    local rm = rl_cfg.row_map[key]
                    if rm then
                        rm.pos_label.Text = "#" .. i
                        if key ~= skip_key then
                            local target = dim2(0, 0, 0, get_row_y(i))
                            if animate then
                                TokaiHub:tween(rm.row, {Position = target}, Enum.EasingStyle.Quint, 0.18)
                            else
                                rm.row.Position = target
                            end
                        end
                    end
                end
                local flag_name = rl_cfg.flag_prefix .. "order"
                flags[flag_name] = table.concat(rl_cfg.order, ",")
                rl_cfg.callback(rl_cfg.order)
            end

            local function calc_visual_positions(drag_key, hover_idx)
                local slot = 0
                for i, key in ipairs(rl_cfg.order) do
                    if key ~= drag_key then
                        slot = slot + 1
                        local vi = slot
                        if slot >= hover_idx then vi = vi + 1 end
                        local rm = rl_cfg.row_map[key]
                        if rm then
                            TokaiHub:tween(rm.row, {Position = dim2(0, 0, 0, get_row_y(vi))}, Enum.EasingStyle.Quint, 0.15)
                        end
                    end
                end
                indicator_line.Visible = true
                indicator_line.Position = dim2(0, 10, 0, get_row_y(hover_idx) - 2)
            end

            local function set_row_zindex(rm, z)
                rm.row.ZIndex = z
                rm.row_bg.ZIndex = z
                rm.pos_label.ZIndex = z + 1
                rm.name_label.ZIndex = z + 1
                rm.grip.ZIndex = z + 1
                rm.sep_line.ZIndex = z
                for _, dot in ipairs(rm.dots) do dot.ZIndex = z + 1 end
            end

            for i, item_data in ipairs(rl_cfg.items_data) do
                local key = item_data.key or item_data.name or item_data
                local display = item_data.display or item_data.name or key

                local row = TokaiHub:create("TextButton", {
                    Parent = rl_items["list_frame"],
                    Name = "\0",
                    Text = "",
                    AutoButtonColor = false,
                    Active = true,
                    BackgroundTransparency = 1,
                    Size = dim2(1, 0, 0, ROW_H),
                    Position = dim2(0, 0, 0, get_row_y(i)),
                    BorderSizePixel = 0,
                })

                local row_bg = TokaiHub:create("Frame", {
                    Parent = row,
                    Name = "\0",
                    Size = dim2(1, -8, 1, -4),
                    Position = dim2(0, 4, 0, 2),
                    BackgroundColor3 = rgb(30, 30, 35),
                    BackgroundTransparency = 1,
                    BorderSizePixel = 0,
                })
                TokaiHub:create("UICorner", { Parent = row_bg, CornerRadius = dim(0, 5) })

                local stroke = TokaiHub:create("UIStroke", {
                    Parent = row_bg,
                    Color = themes.preset.accent,
                    Thickness = 1.5,
                    Transparency = 1,
                })

                local grip = TokaiHub:create("Frame", {
                    Parent = row,
                    Name = "\0",
                    Size = dim2(0, 12, 0, 20),
                    Position = dim2(0, 10, 0.5, -10),
                    BackgroundTransparency = 1,
                })

                local dots = {}
                for dc = 0, 1 do
                    for dr = 0, 2 do
                        local dot = TokaiHub:create("Frame", {
                            Parent = grip,
                            Name = "\0",
                            Size = dim2(0, 3, 0, 3),
                            Position = dim2(0, dc * 7, 0, dr * 7),
                            BackgroundColor3 = rgb(70, 70, 75),
                            BorderSizePixel = 0,
                        })
                        TokaiHub:create("UICorner", { Parent = dot, CornerRadius = dim(0, 2) })
                        dots[#dots + 1] = dot
                    end
                end

                local pos_label = TokaiHub:create("TextLabel", {
                    FontFace = fonts.small,
                    TextColor3 = themes.preset.accent,
                    Text = "#" .. i,
                    Parent = row,
                    Name = "\0",
                    AnchorPoint = vec2(0, 0.5),
                    AutomaticSize = Enum.AutomaticSize.Y,
                    Size = dim2(0, 20, 0, 0),
                    Position = dim2(0, 28, 0.5, -3.8),
                    BackgroundTransparency = 1,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    TextSize = 13,
                })
                TokaiHub:apply_theme(pos_label, "accent", "TextColor3")

                local name_label = TokaiHub:create("TextLabel", {
                    FontFace = fonts.small,
                    TextColor3 = rgb(235, 235, 235),
                    Text = display,
                    Parent = row,
                    Name = "\0",
                    AnchorPoint = vec2(0, 0.5),
                    AutomaticSize = Enum.AutomaticSize.Y,
                    Size = dim2(1, -56, 0, 0),
                    Position = dim2(0, 50, 0.5, -3.8),
                    BackgroundTransparency = 1,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    TextTruncate = Enum.TextTruncate.AtEnd,
                    TextSize = 14,
                })

                local sep_line = TokaiHub:create("Frame", {
                    AnchorPoint = vec2(0, 1),
                    Parent = row,
                    Name = "\0",
                    Position = dim2(0, 8, 1, 0),
                    Size = dim2(1, -16, 0, 1),
                    BorderSizePixel = 0,
                    BackgroundColor3 = rgb(36, 36, 37),
                })

                rl_cfg.row_map[key] = {
                    row = row,
                    row_bg = row_bg,
                    stroke = stroke,
                    grip = grip,
                    dots = dots,
                    pos_label = pos_label,
                    name_label = name_label,
                    sep_line = sep_line,
                }

                row.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 and not rl_cfg._dragging then
                        TokaiHub._drag_locked = true
                        rl_cfg._dragging = key
                        rl_cfg._drag_offset = input.Position.Y - row.AbsolutePosition.Y
                        rl_cfg._hover_index = table.find(rl_cfg.order, key) or 1
                        set_row_zindex(rl_cfg.row_map[key], 50)
                        TokaiHub:tween(row_bg, {BackgroundTransparency = 0}, nil, 0.1)
                        TokaiHub:tween(stroke, {Transparency = 0}, nil, 0.1)
                        for _, d in ipairs(dots) do
                            TokaiHub:tween(d, {BackgroundColor3 = rgb(120, 120, 130)}, nil, 0.1)
                        end
                    end
                end)

                row.MouseEnter:Connect(function()
                    if not rl_cfg._dragging then
                        for _, d in ipairs(dots) do
                            TokaiHub:tween(d, {BackgroundColor3 = rgb(100, 100, 110)}, nil, 0.15)
                        end
                    end
                end)

                row.MouseLeave:Connect(function()
                    if not rl_cfg._dragging or rl_cfg._dragging ~= key then
                        for _, d in ipairs(dots) do
                            TokaiHub:tween(d, {BackgroundColor3 = rgb(70, 70, 75)}, nil, 0.15)
                        end
                    end
                end)
            end

            TokaiHub:connection(uis.InputChanged, function(input)
                if rl_cfg._dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                    local rm = rl_cfg.row_map[rl_cfg._dragging]
                    if rm then
                        local list_abs_y = rl_items["list_frame"].AbsolutePosition.Y
                        local rel_y = input.Position.Y - list_abs_y - rl_cfg._drag_offset
                        rm.row.Position = dim2(0, 0, 0, rel_y)
                        local center_y = rel_y + ROW_H / 2
                        local raw_idx = math.floor((center_y - LIST_PAD) / ROW_H) + 1
                        local hover_idx = math.clamp(raw_idx, 1, #rl_cfg.order)
                        if hover_idx ~= rl_cfg._hover_index then
                            rl_cfg._hover_index = hover_idx
                            calc_visual_positions(rl_cfg._dragging, hover_idx)
                        end
                    end
                end
            end)

            TokaiHub:connection(uis.InputEnded, function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 and rl_cfg._dragging then
                    TokaiHub._drag_locked = false
                    local key = rl_cfg._dragging
                    local hover_idx = rl_cfg._hover_index
                    local rm = rl_cfg.row_map[key]
                    rl_cfg._dragging = nil
                    rl_cfg._hover_index = nil
                    indicator_line.Visible = false
                    if rm then
                        set_row_zindex(rm, 1)
                        TokaiHub:tween(rm.row_bg, {BackgroundTransparency = 1}, nil, 0.15)
                        TokaiHub:tween(rm.stroke, {Transparency = 1}, nil, 0.15)
                        for _, d in ipairs(rm.dots) do
                            TokaiHub:tween(d, {BackgroundColor3 = rgb(70, 70, 75)}, nil, 0.15)
                        end
                    end
                    local old_idx = table.find(rl_cfg.order, key)
                    if old_idx and hover_idx and old_idx ~= hover_idx then
                        table.remove(rl_cfg.order, old_idx)
                        table.insert(rl_cfg.order, math.clamp(hover_idx, 1, #rl_cfg.order + 1), key)
                    end
                    refresh_positions(nil, true)
                end
            end)

            refresh_positions(nil, false)

            local flag_name = rl_cfg.flag_prefix .. "order"
            config_flags[flag_name] = function(v)
                if type(v) == "string" then
                    local parts = {}
                    for part in string.gmatch(v, "[^,]+") do
                        parts[#parts + 1] = part
                    end
                    if #parts == #rl_cfg.order then
                        rl_cfg.order = parts
                        refresh_positions(nil, false)
                    end
                end
            end

            function rl_cfg.get_order()
                return rl_cfg.order
            end

            function rl_cfg.set_order(new_order)
                if type(new_order) == "table" and #new_order == #rl_cfg.order then
                    rl_cfg.order = new_order
                    refresh_positions(nil, false)
                end
            end

            return setmetatable(rl_cfg, library)
        end
