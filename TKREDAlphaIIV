        local function autoload_list_configs()
            local list = {}
            local ok = pcall(function()
                for idx, file in listfiles(library.directory .. "/configs") do
                    local name = file:match("[^/\\]+$"):gsub("%.cfg$", "")
                    list[#list + 1] = name
