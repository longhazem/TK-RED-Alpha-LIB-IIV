        local function autoload_state_path()
            return TokaiHub.directory .. "/autoload.txt"
        end

        local function autoload_list_configs()
            local list = {}
            local ok = pcall(function()
                for idx, file in listfiles(TokaiHub.directory .. "/configs") do
                    local name = file:match("[^/\\]+$"):gsub("%.cfg$", "")
                    list[#list + 1] = name
                end
            end)
            if not ok then
                return {}
            end
            return list
