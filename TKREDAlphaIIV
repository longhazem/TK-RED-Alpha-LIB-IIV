end

-- ── set_accent_color: swap accent across all live UI (WinWare RepaintAccent) ──
function library:set_accent_color(new_color)
    if typeof(new_color) == "string" then
        new_color = Color3.fromHex(new_color:gsub("#", ""))
    end
    local prev = themes.preset.accent
    if prev == new_color then return end
    themes.preset.accent = new_color

    -- Scan every descendant and repaint anything that matches the old accent
    local gui = library["items"]
    if not gui then return end
    local function same(c)
        return math.abs(c.R - prev.R) < 0.01
           and math.abs(c.G - prev.G) < 0.01
           and math.abs(c.B - prev.B) < 0.01
    end
    for _, obj in next, gui:GetDescendants() do
        if obj:GetAttribute("TokaNoAccent") then continue end
        if obj:IsA("GuiObject") then
            if same(obj.BackgroundColor3) then obj.BackgroundColor3 = new_color end
            if (obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox")) then
                if same(obj.TextColor3) then obj.TextColor3 = new_color end
            end
        elseif obj:IsA("UIStroke") then
            if same(obj.Color) then obj.Color = new_color end
        elseif obj:IsA("Frame") then
            if same(obj.BackgroundColor3) then obj.BackgroundColor3 = new_color end
        end
    end
end

