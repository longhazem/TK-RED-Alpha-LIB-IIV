            function TokaiHub:_ensure_info_list()
                local info = TokaiHub._info_list
                if not info then
                    local session_start
                    if getgenv then
                        local env = getgenv()
                        if env.MULTYHUB_SESSION_START == nil then
                            env.MULTYHUB_SESSION_START = env.BRM5_SESSION_START or os.clock()
                        end
