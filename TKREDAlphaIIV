-- Shadow + RollingEffect (WinWare)
function TokaiHub:RollingEffect(parent)
    local g=Instance.new('UIGradient')
    g.Transparency=NumberSequence.new{NumberSequenceKeypoint.new(0,0.4),NumberSequenceKeypoint.new(1,0)}
    g.Parent=parent; return g
end
function TokaiHub:CreateShadow(parent, rollingEffect)
    local Shadow={}; local strokes={}; local rollers={}; local rollerThread
    for _,t in ipairs({6,5,4,3}) do
        local s=Instance.new('UIStroke'); s.Thickness=t; s.Transparency=1; s.Parent=parent; insert(strokes,s)
        if rollingEffect then insert(rollers, TokaiHub:RollingEffect(s)) end
    end
    function Shadow:Render(value)
        if rollerThread then task.cancel(rollerThread); rollerThread=nil end
        local target=value and 0.900 or 1
        for _,s in strokes do local t=tween_service:Create(s,TweenInfo.new(0.22,Enum.EasingStyle.Quint,Enum.EasingDirection.Out),{Transparency=target}); t:Play() end
        if value and rollingEffect then
            rollerThread=task.spawn(function() while true do task.wait(0.025); for _,r in rollers do r.Rotation=r.Rotation+20 end end end)
        end
    end
    return Shadow
end

-- Blur module (WinWare) — lightweight version compatible with Library's existing ScreenGui
TokaiHub.ApplyPopupSurface = function(frame, transparency)
    frame.BackgroundColor3=TokaiHub.MainColor; frame.BackgroundTransparency=transparency or 0.06
    if not TokaiHub.EnabledBlur then return end
    local Lighting=game:GetService('Lighting')
    local part=Instance.new('Part'); local dof=Instance.new('DepthOfFieldEffect'); local mesh=Instance.new('BlockMesh',part)
    dof.Parent=Lighting; dof.Enabled=true; dof.FarIntensity=0; dof.FocusDistance=0; dof.InFocusRadius=1000; dof.NearIntensity=1
    part.Material=Enum.Material.Glass; part.Transparency=1; part.Reflectance=1; part.CastShadow=false
    part.Anchored=true; part.CanCollide=false; part.CanQuery=false; part.Size=Vector3.one*0.01
    local function update()
        local cam=ws.CurrentCamera
        if frame.Visible and frame.BackgroundTransparency<0.9 and not TokaiHub.Global3DRenderMode then
            dof.NearIntensity=1; part.Parent=cam
            local c0=frame.AbsolutePosition; local c1=c0+frame.AbsoluteSize
            local r0=cam:ScreenPointToRay(c0.X,c0.Y,1); local r1=cam:ScreenPointToRay(c1.X,c1.Y,1)
            local po=cam.CFrame.Position+cam.CFrame.LookVector*(0.05-cam.NearPlaneZ); local pn=cam.CFrame.LookVector
            local function calcPos(plOrig,plNorm,rO,rD)
                local n,d,v=plNorm,rD,rO-plOrig
                local num=n.X*v.X+n.Y*v.Y+n.Z*v.Z; local den=n.X*d.X+n.Y*d.Y+n.Z*d.Z
                return rO+((-num/den)*rD)
            end
            local p0=calcPos(po,pn,r0.Origin,r0.Direction); local p1=calcPos(po,pn,r1.Origin,r1.Direction)
            p0=cam.CFrame:PointToObjectSpace(p0); p1=cam.CFrame:PointToObjectSpace(p1)
            local sz=p1-p0; mesh.Offset=(p0+p1)/2; mesh.Scale=sz/0.0101; part.CFrame=cam.CFrame
        else
            dof.NearIntensity=0; part.Parent=nil
        end
    end
    task.spawn(function()
        while frame.Parent do task.wait(0.08); pcall(update) end
        part:Destroy(); dof:Destroy()
    end)
end

