-- Text Shimmer (WinWare)
function TokaiHub:EnableTextShimmer(label, gradient, options)
    if label:GetAttribute('TokaiHubShimmerEnabled') then return end
    label:SetAttribute('TokaiHubShimmerEnabled', true)
    options=options or {}; local speed=options.Speed or 1.5; local sz=options.Size or 0.25; local running=true
    task.spawn(function()
        local t=0
        while running and label.Parent do
            t=t+(task.wait()/speed)
            if t>1 then t=t-1 end
            local ks={}
            local function kp(p,tr) insert(ks,NumberSequenceKeypoint.new(math.max(0,math.min(1,p)),tr)) end
            kp(0,0.5); kp(math.max(0,t-sz),0.5); kp(t,0); kp(math.min(1,t+sz),0.5); kp(1,0.5)
            table.sort(ks,function(a,b) return a.Time<b.Time end)
            local u={}; local seen={}
            for _,k in ks do if not seen[k.Time] then seen[k.Time]=true; insert(u,k) end end
            if #u>=2 and gradient then pcall(function() gradient.Transparency=NumberSequence.new(u) end) end
        end
    end)
    label.Destroying:Connect(function() running=false end)
end

-- Overflow Marquee (WinWare)
function TokaiHub:EnableOverflowMarquee(label, options)
    if label:GetAttribute('TokaiHubMarqueeEnabled') then return end
    label:SetAttribute('TokaiHubMarqueeEnabled', true)
    options=options or {}; local speed=options.Speed or 40; local delay_time=options.Delay or 1.5
    local hoverTarget=options.HoverTarget or label; local running=false; local hovering=false
    local ts2=game:GetService('TextService')
    local function startMarquee()
        if running then return end; running=true
        task.spawn(function()
            task.wait(delay_time)
            while running and hovering and label.Parent do
                local tw=ts2:GetTextSize(label.Text,label.TextSize,Enum.Font.Montserrat,Vector2.new(math.huge,math.huge)).X
                local fw=label.AbsoluteSize.X
                if tw<=fw then break end
                local extra=tw-fw+10; local steps=extra/(speed*0.016); local step=extra/steps
                for _=1,steps do
                    if not running or not hovering then break end
                    label.Position=UDim2.new(label.Position.X.Scale,label.Position.X.Offset-step,label.Position.Y.Scale,label.Position.Y.Offset)
                    task.wait(0.016)
                end
                task.wait(delay_time)
                for _=1,steps do
                    if not running then break end
                    label.Position=UDim2.new(label.Position.X.Scale,label.Position.X.Offset+step,label.Position.Y.Scale,label.Position.Y.Offset)
                    task.wait(0.016)
                end
                task.wait(delay_time)
            end
            label.Position=UDim2.new(label.Position.X.Scale,0,label.Position.Y.Scale,label.Position.Y.Offset)
            running=false
        end)
    end
    hoverTarget.MouseEnter:Connect(function() hovering=true; startMarquee() end)
    hoverTarget.MouseLeave:Connect(function() hovering=false; running=false end)
    label.Destroying:Connect(function() running=false end)
end

