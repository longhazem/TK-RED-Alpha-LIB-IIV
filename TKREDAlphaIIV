-- ── AutoScale helpers ─────────────────────────────────────────────────
    local _AutoScaleTargets = {}
    local _AutoScaleEnabled = true
    local _AutoScaleMultiplier = 1
    local _AutoScaleMin = _IsMobile and 0.78 or 0.72
    local _AutoScaleMax = _IsMobile and 1.3  or 1.2
    local _AutoScaleBase = Vector2.new(1920, 1080)

    local function _GetViewportSize()
        local cam = ws.CurrentCamera
        if cam and cam.ViewportSize.X > 0 then return cam.ViewportSize end
        local x, y = pcall(function() return game:GetService("GuiService"):GetScreenResolution() end)
        if x and y and x > 0 then return Vector2.new(x, y) end
        return Vector2.new(1920, 1080)
    end

    local function _CalcScale()
        local vp = _GetViewportSize()
        local s = math.min(vp.X / _AutoScaleBase.X, vp.Y / _AutoScaleBase.Y)
        if _IsMobile then s = s * 1.35 end
        return math.clamp(s, _AutoScaleMin, _AutoScaleMax) * _AutoScaleMultiplier
    end

    local function _RefreshAutoScale()
        if not _AutoScaleEnabled then return end
        local sv = _CalcScale()
        for target, data in next, _AutoScaleTargets do
            if not target or target.Parent == nil then
                _AutoScaleTargets[target] = nil
            else
                local us = data.UIScale
                if not us or us.Parent ~= target then
                    us = target:FindFirstChild("__TokaiAutoScale")
                    if not us then
                        us = Instance.new("UIScale")
                        us.Name = "__TokaiAutoScale"
                        us.Parent = target
                    end
                    data.UIScale = us
                end
                us.Scale = sv * (data.Multiplier or 1)
            end
        end
    end

